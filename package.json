{
  "name": "newapp-backup",
  "version": "1.0.0",
  "description": "Modern Windows backup application with WebDAV support, compression & encryption",
  "main": "dist/main/index.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && electron .",
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\"",
    "build:renderer": "tsc -p tsconfig.json && vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build": "npm run build:renderer && npm run build:main",
    "preview": "electron-builder --win",
    "lint": "eslint src/"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "extract-zip": "^2.0.1",
    "node-schedule": "^2.1.1",
    "webdav": "^5.7.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.14.1",
    "@types/node-schedule": "^2.1.7",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^42.2.0",
    "electron-builder": "^25.1.8",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
